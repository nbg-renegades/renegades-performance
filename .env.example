# Copy to .env for local development. Vite does not let .env override variables that are
# already set in the environment, so Netlify's site variables always win in CI builds.
#
# These are publishable values (the anon key is safe in a browser bundle); RLS is what
# protects the data. Get the key from Supabase → Settings → API Keys → anon/public.
VITE_SUPABASE_PROJECT_ID="ekmdcqcjvodsnaqpsgun"
VITE_SUPABASE_URL="https://ekmdcqcjvodsnaqpsgun.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon key>"
